{
    "manifest_version": 3,
    "name": "Wiki Exporter",
    "version": "0.9.99.1",
    "description": "No AI. Human crawler. For lazy people.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "optional_permissions": [
        "tabs"
    ],
    "optional_host_permissions": [
        "https://*.fandom.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "version_name": "1.0.0-rc.1"
}
